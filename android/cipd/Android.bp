package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

bootstrap_go_package {
    name: "soong-android-cipd",
    pkgPath: "android/soong/android/cipd",
    deps: [
        "blueprint",
        "blueprint-gobtools",
        "blueprint-proptools",
        "soong-android",
    ],
    srcs: [
        "cipd_package.go",
        "cipd_enc.go",
    ],
    testSrcs: [
        "cipd_package_test.go",
    ],
    pluginFor: ["soong_build"],
}
